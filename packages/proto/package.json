{
  "name": "@apmc/proto",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auction": {
      "types": "./dist/auction.d.ts",
      "default": "./dist/auction.js"
    },
    "./signaling": {
      "types": "./dist/signaling.d.ts",
      "default": "./dist/signaling.js"
    },
    "./market": {
      "types": "./dist/market.d.ts",
      "default": "./dist/market.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "proto:generate": "protoc --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=./src --proto_path=../../proto ../../proto/auction.proto ../../proto/signaling.proto ../../proto/market.proto",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@apmc/shared": "*",
    "typescript": "^5.4.0",
    "ts-proto": "^1.17.0",
    "protobufjs": "^7.2.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.57.0"
  }
}