# APMC System — environment variables
#
# Every value below has a working default in packages/config/src/index.ts, so you
# can run the whole stack with NO .env at all (defaults target localhost infra).
# Copy this file to `.env` only if you need to override something.
#
#   cp .env.example .env

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Datastores (match docker-compose.yml service ports) ─────────────────────
DATABASE_URL=postgresql://apmc:apmc@localhost:5432/apmc
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379

# ── Kafka / Redpanda (MOM) ──────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=apmc-system
KAFKA_CONSUMER_GROUP=apmc-consumers

# ── gRPC service ports ──────────────────────────────────────────────────────
AUCTION_GRPC_PORT=50051
SIGNALING_GRPC_PORT=50052
P2P_GRPC_PORT=50053
NAMING_GRPC_PORT=50054

# ── Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_HTTP_PORT=8000
GATEWAY_GRPC_PORT=8001

# ── Auth (JWT_SECRET must be >= 32 chars) ───────────────────────────────────
JWT_SECRET=development-secret-change-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── WebRTC / TURN ───────────────────────────────────────────────────────────
# Leave unset to skip TURN in the ICE config (peers then get STUN only).
# `npm run dev:services` already defaults these to the values below, so you only
# need them here for the full-Docker path or to point at a different TURN server.
# The credential MUST match the coturn container's `--user=apmc:apmcpass` in
# docker-compose.yml, or relay allocation fails with a 401.
# TURN_SERVER=turn:localhost:3478
# TURN_USERNAME=apmc
# TURN_CREDENTIAL=apmcpass

# ── Observability ───────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# JAEGER_ENDPOINT=http://localhost:14268/api/traces
# PROMETHEUS_PORT is set per-service by scripts/dev-services.mjs; the default here
# is only used when running a single service directly.
PROMETHEUS_PORT=9090

# ── Service discovery ───────────────────────────────────────────────────────
SERVICE_NAME=apmc-service
SERVICE_VERSION=1.0.0
